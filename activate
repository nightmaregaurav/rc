# Skip if sourced within the last 2 seconds
now=$(date +%s)

if [ -n "${rc_sourced:-}" ] && [ $((now - rc_sourced)) -lt 2 ]; then
    return 0
fi

# Determine if benchmarking is enabled
if [ -n "${RC_BENCHMARK}" ]; then
    current_time_ms() {
        if command -v date >/dev/null 2>&1; then
            # Use date command if available
            if date --version >/dev/null 2>&1; then
                # GNU date (Linux) - use milliseconds
                echo $(date +%s%3N)
            else
                # macOS date or other Unix-like systems without %3N
                echo $(($(date +%s) * 1000 + $(date +%N | cut -b1-3)))
            fi
        else
            echo "Error: 'date' command is not available"
            return 1
        fi
    }
    __bench_start_time=0
    benchmark() {
        local step_name="$1"
        if [ "$step_name" = "Start" ]; then
            __bench_start_time=$(current_time_ms)
            echo "[BENCHMARK] ${step_name}: Benchmarking started"
            return
        fi
        local now=$(current_time_ms)
        local elapsed=$((now - __bench_start_time))
        echo "[BENCHMARK] ${step_name}: ${elapsed} ms"
        __bench_start_time=$now
    }
else
    benchmark() { :; }  # no-op if benchmarking is disabled
fi
benchmark "Start"

# Determine the directory of this sourced file
if [ -n "${BASH_VERSION:-}" ]; then
    export current_rc_script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
elif [ -n "${ZSH_VERSION}" ]; then
    export current_rc_script_dir="$(cd "$(dirname "${(%):-%x}")" && pwd)"
elif [ -n "${KSH_VERSION:-}" ]; then
    current_rc_script_dir=$(cd "$(dirname "${.sh.file}")" && pwd)
elif [ -f "./activate" ] && [ -f "./setup" ]; then
    current_rc_script_dir="$(pwd)"
else
    export current_rc_script_dir="/opt/rc"
fi
benchmark "Determine current_rc_script_dir"

# Enable loading completion in zsh
if [ -n "${ZSH_VERSION}" ]; then
    autoload -Uz compinit && compinit
    autoload -Uz bashcompinit && bashcompinit
fi
benchmark "Enabling zsh completion"

# Source environment variables, tools, aliases
source "$current_rc_script_dir/envs"

source "$current_rc_script_dir/tools/source"

source "$current_rc_script_dir/aliases"
benchmark "Sourced aliases"

# Save public IP Address to a file
(publicip > "$HOME/.ip.public" &) > /dev/null 2>&1
benchmark "Save public IP"

# Save local IP Address to a file
(localip > "$HOME/.ip.local" &) > /dev/null 2>&1
benchmark "Save local IP"

# Configure history file and sizes.
# For zsh: /etc/zshrc overwrites HISTFILE after /etc/zshenv sources this script,
# so we defer the reinitialization to a precmd hook that runs after all startup files.
# For bash: /etc/bashrc is sourced after /etc/profile, but our activate has a
# 2-second debounce that skips the second source, so we use PROMPT_COMMAND to
# ensure the history file is set correctly.
export HISTFILESIZE=10000
export SAVEHIST=10000
export HISTSIZE=2000
export HISTFILE="$HOME/.history"

if [ -n "${ZSH_VERSION:-}" ]; then
    setopt INC_APPEND_HISTORY
    # Defer history reinitialization to after all startup files (including /etc/zshrc)
    # have been sourced. This precmd hook runs once on the first prompt, then removes itself.
    # precmd only works in interactive shells, so guard with $interactive.
    if [[ $interactive == yes ]]; then
        _rc_history_init() {
            # Reinitialize zsh history with the new file and sizes.
            # Note: fc -p expects (file, histsize, savehist) — order differs from variable names
            fc -p "$HISTFILE" "$HISTSIZE" "$SAVEHIST"
            # Remove this hook after it runs once
            precmd -d _rc_history_init
        }
        precmd _rc_history_init
    else
        # Non-interactive shell: apply immediately
        fc -p "$HISTFILE" "$HISTSIZE" "$SAVEHIST"
    fi
elif [ -n "${BASH_VERSION:-}" ]; then
    shopt -s histappend
    # Use PROMPT_COMMAND to ensure HISTFILE is set and history is reloaded
    # after /etc/bashrc has been sourced (which may overwrite HISTFILE)
    _rc_history_init() {
        export HISTFILE="$HOME/.history"
        export HISTFILESIZE=10000
        export HISTSIZE=2000
        history -n
        unset -f _rc_history_init
    }
    PROMPT_COMMAND="_rc_history_init${PROMPT_COMMAND:+;${PROMPT_COMMAND}};history -a"
fi
benchmark "Configure history"

# Filter duplicates from PATH
export PATH=$(echo "$PATH" | awk -v RS=':' '!seen[$0]++ { path = path (NR==1 ? "" : ":") $0 } END { print path }')
benchmark "Filter duplicates from PATH"

benchmark "End"

export rc_sourced="$now"

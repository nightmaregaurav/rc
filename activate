# Skip reinitialization when multiple shell startup files source RC within 2 seconds.
now=$(date +%s)

if [ -n "${rc_sourced:-}" ] && [ $((now - rc_sourced)) -lt 2 ]; then
    return 0
fi

# Determine if benchmarking is enabled
if [ -n "${RC_BENCHMARK}" ]; then
    current_time_ms() {
        if command -v date >/dev/null 2>&1; then
            # Use date command if available
            if date --version >/dev/null 2>&1; then
                # GNU date (Linux) - use milliseconds
                echo $(date +%s%3N)
            else
                # macOS date or other Unix-like systems without %3N
                local nanos
                nanos=$(date +%N 2>/dev/null)
                case "$nanos" in
                    ''|*[!0-9]*) nanos=0 ;;
                    *) nanos=$(printf '%s' "$nanos" | cut -b1-3) ;;
                esac
                while [ "${nanos#0}" != "$nanos" ]; do
                    nanos=${nanos#0}
                done
                [ -n "$nanos" ] || nanos=0
                echo $(( $(date +%s) * 1000 + nanos ))
            fi
        else
            echo "Error: 'date' command is not available"
            return 1
        fi
    }
    __bench_start_time=0
    benchmark() {
        local step_name="$1"
        if [ "$step_name" = "Start" ]; then
            __bench_start_time=$(current_time_ms)
            echo "[BENCHMARK] ${step_name}: Benchmarking started"
            return
        fi
        local now=$(current_time_ms)
        local elapsed=$((now - __bench_start_time))
        echo "[BENCHMARK] ${step_name}: ${elapsed} ms"
        __bench_start_time=$now
    }
else
    benchmark() { :; }  # no-op if benchmarking is disabled
fi
benchmark "Start"

# Determine the directory of this sourced file
if [ -n "${BASH_VERSION:-}" ]; then
    export current_rc_script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
elif [ -n "${ZSH_VERSION}" ]; then
    export current_rc_script_dir="$(cd "$(dirname "${(%):-%x}")" && pwd)"
elif [ -n "${KSH_VERSION:-}" ]; then
    current_rc_script_dir=$(cd "$(dirname "${.sh.file}")" && pwd)
elif [ -f "./activate" ] && [ -f "./setup" ]; then
    current_rc_script_dir="$(pwd)"
else
    export current_rc_script_dir="/opt/rc"
fi
benchmark "Determine current_rc_script_dir"

# Enable loading completion in zsh
if [ -n "${ZSH_VERSION}" ]; then
    autoload -Uz compinit && compinit
    autoload -Uz bashcompinit && bashcompinit
fi
benchmark "Enabling zsh completion"

# Source environment variables, tools, aliases
source "$current_rc_script_dir/envs"

source "$current_rc_script_dir/tools/source"

source "$current_rc_script_dir/aliases"
benchmark "Sourced aliases"


# Configure enhanced history settings.
# Let each shell use its default history file location.
# These variables are respected by bash, zsh, and sh without needing custom hooks.

# History sizes — keep a large on-disk history and a generous in-memory buffer.
export HISTFILESIZE=10000
export SAVEHIST=10000
export HISTSIZE=10000

# Duplicate filtration: keep the latest occurrence of each command.
# Bash: erasedups removes all previous duplicates when a new command is added.
# ignorespace skips commands starting with a space (useful for sensitive data).
export HISTCONTROL=erasedups:ignorespace

# Zsh-specific enhancements (safe to skip in non-zsh shells).
if [ -n "${ZSH_VERSION:-}" ]; then
    setopt INC_APPEND_HISTORY    # Append history incrementally after each command
    setopt HIST_IGNORE_ALL_DUPS  # Remove older duplicates when a new command is added
    setopt HIST_IGNORE_DUPS      # Don't record a command if it matches the previous one
    setopt HIST_REDUCE_BLANKS    # Remove superfluous blanks from each command
    setopt HIST_SAVE_NO_DUPS     # Don't write duplicates to the history file
fi

# Bash-specific enhancements (safe to skip in non-bash shells).
if [ -n "${BASH_VERSION:-}" ]; then
    shopt -s histappend          # Append to history file instead of overwriting
    shopt -s cmdhist             # Keep multiline commands as one entry
    shopt -s lithist             # Save multiline commands with embedded newlines
fi
benchmark "Configure history"

# Filter duplicates from PATH using pure shell (no subprocess spawn, POSIX-portable)
_deduped_path=""
_path_remaining="$PATH"
while [ -n "$_path_remaining" ]; do
    _p="${_path_remaining%%:*}"
    if [ "$_p" = "$_path_remaining" ]; then
        _path_remaining=""
    else
        _path_remaining="${_path_remaining#*:}"
    fi
    case ":${_deduped_path}:" in
        *:"$_p":*) ;; # already present, skip
        *) [ -z "$_deduped_path" ] && _deduped_path="$_p" || _deduped_path="$_deduped_path:$_p" ;;
    esac
done
export PATH="$_deduped_path"
unset _deduped_path _path_remaining _p
benchmark "Filter duplicates from PATH"

benchmark "End"

export rc_sourced="$now"

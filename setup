#!/usr/bin/env bash

SCRIPT=$(basename "$0")

HELP_MESSAGE="Usage: $SCRIPT

Clones rc, sets up the required environment, and sources it to the shell configuration file.

options:
  -h, --help    Show help message and exit."

# Help message (before any environment detection)
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "$HELP_MESSAGE"
  exit 0
fi

# ---------------------------------------------------------------------------
# Environment detection (single source of truth)
# ---------------------------------------------------------------------------
UNAME_SYS="$(uname -s)"

# Determine environment type: termux | git-bash | macos | linux | unsupported
ENV_TYPE="linux"
case "$UNAME_SYS" in
    MINGW*|MSYS*|CYGWIN*)
        ENV_TYPE="git-bash"
        ;;
    Darwin)
        ENV_TYPE="macos"
        ;;
    Linux)
        if [ -n "${PREFIX:-}" ]; then
            ENV_TYPE="termux"
        fi
        ;;
    *)
        ENV_TYPE="unsupported"
        ;;
esac

echo "=========================================="
echo "  rc Setup Script"
echo "=========================================="
echo ""
echo "Detected environment: $ENV_TYPE"

# ---------------------------------------------------------------------------
# Environment-specific fallbacks
# ---------------------------------------------------------------------------

# sudo() helper — strips common sudo flags and runs the command
sudo_helper() {
  while [ "$1" = "-n" ] || [ "$1" = "-H" ] || [ "$1" = "-E" ]; do
    shift
  done
  "$@"
}

case "$ENV_TYPE" in
    termux)
        # Termux: sudo is a no-op
        sudo() { sudo_helper "$@"; }
        ;;
    git-bash)
        # Disable MSYS path conversion to prevent path corruption
        export MSYS_NO_PATHCONV=1

        # Git Bash: sudo is a no-op
        sudo() { sudo_helper "$@"; }

        # Git Bash may not have whoami
        if ! command -v whoami >/dev/null 2>&1; then
          whoami() {
            echo "${USER:-${USERNAME:-$(cmd.exe /c echo %USERNAME%)}}"
          }
        fi

        # Git Bash: id does not resolve group name
        id() {
          if [ "$1" = "-gn" ]; then
            echo "${USERDOMAIN:-Users}"
          else
            echo "0"
          fi
        }
        ;;
esac

# ---------------------------------------------------------------------------
# Root directory based on environment
# ---------------------------------------------------------------------------
case "$ENV_TYPE" in
    termux)
        ROOT_DIR="$PREFIX"
        echo "Root directory: $ROOT_DIR (Termux PREFIX)"
        ;;
    git-bash)
        ROOT_DIR="/c"
        echo "Root directory: $ROOT_DIR (Git Bash C: drive)"
        ;;
    *)
        ROOT_DIR=""
        echo "Root directory: / (native)"
        ;;
esac

set -euo pipefail

# ---------------------------------------------------------------------------
# Prepare workspace directory
# ---------------------------------------------------------------------------
start_dir=$(pwd)
CURRENT_USER=$(whoami)
GROUP=$(id -gn "$CURRENT_USER")

echo ""
echo "Preparing workspace directory: $ROOT_DIR/opt/rc ..."
sudo mkdir -p "$ROOT_DIR/opt/rc"

case "$ENV_TYPE" in
    termux|git-bash)
        echo "Skipping ownership and permission changes (not applicable in $ENV_TYPE)."
        ;;
    *)
        echo "Setting ownership to root:$GROUP and enabling group write access..."
        sudo chown -R "root:$GROUP" "$ROOT_DIR/opt/rc"
        sudo chmod -R g+rw "$ROOT_DIR/opt/rc"
        ;;
esac

# ---------------------------------------------------------------------------
# Clone or update the rc repository
# ---------------------------------------------------------------------------
echo ""
echo "Cloning rc repository to $ROOT_DIR/opt/rc ..."
cd "$ROOT_DIR/opt/rc"
if [ -d .git ]; then
    echo "Repository already exists — pulling latest changes..."
    git pull
else
    echo "Cloning from https://github.com/nightmaregaurav/rc.git ..."
    git clone https://github.com/nightmaregaurav/rc.git .
    git config --global --add safe.directory "$ROOT_DIR/opt/rc"
fi

# ---------------------------------------------------------------------------
# Write source line to shell profile files
# ---------------------------------------------------------------------------
echo ""
echo "Adding 'source' line to shell profile files..."

case "$ENV_TYPE" in
    git-bash)
        # Git Bash uses user-level profile files instead of system-wide /etc/ files
        HOME_DIR="${HOME:-$USERPROFILE}"
        potential_default_sources="
$HOME_DIR/.bash_profile
$HOME_DIR/.bashrc
$HOME_DIR/.profile
"
        ;;
    *)
        potential_default_sources="
$ROOT_DIR/etc/profile
$ROOT_DIR/etc/profile.d/rc
$ROOT_DIR/etc/bash.bashrc
$ROOT_DIR/etc/bash/bashrc
$ROOT_DIR/etc/bashrc
$ROOT_DIR/etc/zprofile
$ROOT_DIR/etc/zshrc
$ROOT_DIR/etc/zshenv
$ROOT_DIR/etc/zlogin
"
        ;;
esac

for source_file in $potential_default_sources; do
    [ -z "$source_file" ] && continue
    sudo mkdir -p "$(dirname "$source_file")"

    if [ ! -e "$source_file" ]; then
        sudo touch "$source_file"
    fi

    if ! grep -Fxq "source $ROOT_DIR/opt/rc/activate" "$source_file"; then
        printf '%s\n' "source $ROOT_DIR/opt/rc/activate" | sudo tee -a "$source_file" >/dev/null
        echo "  Added to: $source_file"
    else
        echo "  Already present in: $source_file"
    fi
done

# ---------------------------------------------------------------------------
# Source the activate script in the current shell
# ---------------------------------------------------------------------------
set +euo pipefail
echo ""
echo "Activating rc in the current shell..."
source "$ROOT_DIR/opt/rc/activate"
set -euo pipefail

# ---------------------------------------------------------------------------
# Install uv (Python version manager)
# ---------------------------------------------------------------------------
cd "$start_dir"
echo ""
echo "Setting up uv (Python version manager)..."

case "$ENV_TYPE" in
    macos)
        if ! command -v brew >/dev/null 2>&1; then
            echo "Error: Homebrew is required but not found. Install it from https://brew.sh/"
            exit 1
        fi
        if command -v uv >/dev/null 2>&1; then
            echo "uv is already installed."
        else
            echo "Installing uv via Homebrew..."
            brew install uv
        fi
        ;;

    termux)
        if command -v uv >/dev/null 2>&1; then
            echo "uv is already installed."
        else
            echo "Installing uv via pkg (Termux)..."
            pkg install uv
        fi
        ;;

    git-bash)
        if command -v uv >/dev/null 2>&1; then
            echo "uv is already installed."
        else
            # Try winget first (available in PowerShell/CMD, sometimes in Git Bash)
            if command -v winget >/dev/null 2>&1; then
                echo "Installing uv via winget..."
                winget install --id=astral-sh.uv -e --source winget
            else
                echo "winget not available. Installing uv via curl..."
                curl -LsSf https://astral.sh/uv/install.sh | sh
            fi
        fi
        ;;

    linux)
        if command -v uv >/dev/null 2>&1; then
            echo "uv is already installed."
        else
            echo "Installing uv via curl..."
            curl -LsSf https://astral.sh/uv/install.sh | sh
        fi
        ;;

    unsupported)
        echo "Error: Unsupported environment — cannot install uv automatically."
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# Install Python and required packages
# ---------------------------------------------------------------------------
echo ""
RC_PYTHON_VERSION="${RC_PYTHON_VERSION:-3.13}"
echo "Installing Python $RC_PYTHON_VERSION..."
uv python install "$RC_PYTHON_VERSION"

echo "Installing argcomplete..."
uv tool install argcomplete

echo ""
echo "=========================================="
echo "  Setup completed successfully!"
echo "=========================================="

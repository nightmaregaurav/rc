#!/usr/bin/env bash

SCRIPT=$(basename "$0")

# Detect if running in Git Bash (MINGW/MSYS/CYGWIN on Windows)
is_git_bash=false
OS="$(uname -s)"
case "$OS" in
    MINGW*|MSYS*|CYGWIN*)
        is_git_bash=true
        ;;
esac

# If running in Termux, make sudo a no-op
if [ -n "$PREFIX" ]; then
  sudo() {
    # ignore common sudo flags if present
    while [ "$1" = "-n" ] || [ "$1" = "-H" ] || [ "$1" = "-E" ]; do
      shift
    done
    "$@"
  }
fi

# If running in Git Bash, handle missing Unix commands
if $is_git_bash; then
  # Disable MSYS path conversion to prevent path corruption
  export MSYS_NO_PATHCONV=1

  # Git Bash doesn't have sudo; make it a no-op
  if ! command -v sudo >/dev/null 2>&1; then
    sudo() {
      # ignore common sudo flags if present
      while [ "$1" = "-n" ] || [ "$1" = "-H" ] || [ "$1" = "-E" ]; do
        shift
      done
      "$@"
    }
  fi

  if ! command -v whoami >/dev/null 2>&1; then
    whoami() {
      echo "${USER:-${USERNAME:-$(cmd.exe /c echo %USERNAME%)}}"
    }
  fi

  id() {
    if [ "$1" = "-gn" ]; then
      echo "${USERDOMAIN:-Users}"
    else
      echo "0"
    fi
  }
  fi
fi

HELP_MESSAGE="Usage: $SCRIPT

Clones rc, sets up the required environment, and sources it to the shell configuration file.

options:
  -h, --help    Show help message and exit."

# Help message
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "$HELP_MESSAGE"
  exit 0
fi

if [ -n "$PREFIX" ]; then
    echo "Running in Termux. Will use $PREFIX as the root directory."
    ROOT_DIR="$PREFIX"
elif $is_git_bash; then
    echo "Running in git-bash. Will use /c as the root directory."
    ROOT_DIR="/c"
else
    echo "Running in native environment. Will use / as the root directory."
    ROOT_DIR=""
fi

set -euo pipefail

# Get current user and group
start_dir=$(pwd)
CURRENT_USER=$(whoami)
GROUP=$(id -gn "$CURRENT_USER")

echo "Preparing $ROOT_DIR/opt/rc directory..."
sudo mkdir -p $ROOT_DIR/opt/rc

if [ "$ROOT_DIR" = "" ]; then
    echo "Running in native environment. No need to change ownership or set permissions."
elif $is_git_bash; then
    echo "Running in Git Bash. Skipping ownership and permission changes (not applicable on Windows)."
else
    # Set ownership of $ROOT_DIR/opt/rc to root:<current group>
    echo "Changing ownership of $ROOT_DIR/opt/rc to root:$GROUP..."
    sudo chown -R root:"$GROUP" $ROOT_DIR/opt/rc

    # Set group write permissions on $ROOT_DIR/opt/rc
    echo "Setting group write permissions on $ROOT_DIR/opt/rc..."
    sudo chmod -R g+rw $ROOT_DIR/opt/rc
fi

# Clone the rc repository
echo "Preparing to clone rc repository..."
cd $ROOT_DIR/opt/rc
if [ -d .git ]; then
    echo "rc repository already exists. Pulling latest changes..."
    git pull
else
    echo "Cloning rc repository..."
    git clone https://github.com/nightmaregaurav/rc.git .
    git config --global --add safe.directory $ROOT_DIR/opt/rc
fi

# Write source line to shell rc files
echo "Writing source line to shell profile..."
# since our activate script skips after being sourced once it's safer to source activate script in them all
if $is_git_bash; then
    # In Git Bash, use user-level profile files instead of system-wide /etc/ files
    HOME_DIR="${HOME:-$USERPROFILE}"
    potential_default_sources="
$HOME_DIR/.bash_profile
$HOME_DIR/.bashrc
$HOME_DIR/.profile
"
else
    potential_default_sources="
$ROOT_DIR/etc/profile
$ROOT_DIR/etc/profile.d/rc
$ROOT_DIR/etc/bash.bashrc
$ROOT_DIR/etc/bash/bashrc
$ROOT_DIR/etc/bashrc
$ROOT_DIR/etc/zprofile
$ROOT_DIR/etc/zshrc
$ROOT_DIR/etc/zshenv
$ROOT_DIR/etc/zlogin
"
fi

for source_file in $potential_default_sources; do
    sudo mkdir -p "$(dirname "$source_file")"

    if [ ! -e "$source_file" ]; then
        sudo touch "$source_file"
    fi

    if ! grep -Fxq "source $ROOT_DIR/opt/rc/activate" "$source_file"; then
        printf '%s\n' "source $ROOT_DIR/opt/rc/activate" | sudo tee -a "$source_file" >/dev/null
    fi
done

# Source the activate script in the current shell
set +euo pipefail
echo "Sourcing activate script directly to activate rc in the current shell..."
source $ROOT_DIR/opt/rc/activate

# Continue with the rest of your setup (e.g., install uv and other tools)
set -euo pipefail
cd "$start_dir"
echo "Setting up uv..."
echo "Detecting operating system..."
OS_FOR_UV="$(uname -s)"
case "$OS_FOR_UV" in
    Darwin)
        echo "Detected macOS."
        if ! command -v brew >/dev/null 2>&1; then
            echo "Homebrew not found. Please install Homebrew first: https://brew.sh/"
            exit 1
        fi
        if ! command -v uv >/dev/null 2>&1; then
            echo "Installing uv with Homebrew..."
            brew install uv
        else
            echo "UV is already installed"
        fi
        ;;

    Linux)
        set +u
        if [[ -n "$TERMUX_VERSION" ]]; then
            echo "Detected Android (Termux)."
            if ! command -v uv >/dev/null 2>&1; then
                echo "Installing uv with pkg..."
                pkg install uv
            else
                echo "UV is already installed"
            fi
        else
            echo "Detected Linux."
            if ! command -v uv >/dev/null 2>&1; then
                echo "Installing uv with curl..."
                curl -LsSf https://astral.sh/uv/install.sh | sh
            else
                echo "UV is already installed"
            fi
        fi
        set -u
        ;;

    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        echo "Detected Windows."
        if ! command -v uv >/dev/null 2>&1; then
            # Try winget first (available in PowerShell/CMD, sometimes in Git Bash)
            if command -v winget >/dev/null 2>&1; then
                echo "Installing uv with winget..."
                winget install --id=astral-sh.uv -e --source winget
            else
                # Fall back to the official uv installer script (works in Git Bash)
                echo "winget not found. Installing uv with curl..."
                curl -LsSf https://astral.sh/uv/install.sh | sh
            fi
        else
            echo "UV is already installed"
        fi
        ;;

    *)
        echo "Unsupported OS: $OS_FOR_UV"
        exit 1
        ;;
esac

echo "Installing Python versions 3.13 using uv..."
uv python install 3.13
echo "Installing argcomplete package using uv..."
uv tool install argcomplete
echo "Setup completed successfully."

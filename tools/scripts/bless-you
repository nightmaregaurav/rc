#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.13"
# dependencies = [
# 	"argcomplete",
# 	"mediapipe",
# 	"numpy",
# 	"sounddevice",
# 	"soundfile",
# ]
# ///

from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

import argcomplete
import mediapipe as mp
import numpy as np
import sounddevice as sd
import soundfile as sf
from argcomplete.completers import DirectoriesCompleter


YAMNET_URL = "https://storage.googleapis.com/mediapipe-models/audio_classifier/yamnet/float32/1/yamnet.tflite"
YAMNET_CLASS_COUNT = 521
YAMNET_SNEEZE_INDEX = 44
WINDOW_SECONDS = 1.0
WINDOW_HOP_SECONDS = 0.48
MODEL_DIR = Path(__file__).resolve().parents[2] / ".local" / "models"
YAMNET_PATH = MODEL_DIR / "yamnet" / "yamnet.tflite"
MEMORY_PATH = MODEL_DIR / "bless-you" / "sneeze.npz"
AUDIO_EXTENSIONS = {".aif", ".aiff", ".au", ".caf", ".flac", ".mp3", ".ogg", ".wav"}
MIN_CONFIDENCE = 0.05


def parse_device(value: str) -> str | int | None:
	value = value.strip()
	if not value:
		return None
	if value.isdigit() or (value.startswith("-") and value[1:].isdigit()):
		return int(value)
	return value


def ensure_yamnet_model() -> Path:
	if YAMNET_PATH.is_file() and YAMNET_PATH.stat().st_size > 1_000_000:
		return YAMNET_PATH

	YAMNET_PATH.parent.mkdir(parents=True, exist_ok=True)
	temporary_path = YAMNET_PATH.with_suffix(".tflite.tmp")
	try:
		print("[INFO] Downloading the YAMNet sound classifier...")
		with urllib.request.urlopen(YAMNET_URL, timeout=60) as response:
			with temporary_path.open("wb") as model_file:
				while chunk := response.read(1024 * 1024):
					model_file.write(chunk)

		if temporary_path.stat().st_size <= 1_000_000:
			raise RuntimeError("Downloaded model file is unexpectedly small.")

		os.replace(temporary_path, YAMNET_PATH)
		print(f"[INFO] Model saved to {YAMNET_PATH}")
		return YAMNET_PATH
	except Exception as exc:
		temporary_path.unlink(missing_ok=True)
		if isinstance(exc, urllib.error.URLError):
			raise RuntimeError(f"Could not download the YAMNet model: {exc}") from exc
		raise


def create_classifier(model_path: Path):
	options = mp.tasks.audio.AudioClassifierOptions(
		base_options=mp.tasks.BaseOptions(model_asset_path=str(model_path)),
		max_results=YAMNET_CLASS_COUNT,
		score_threshold=0.0,
	)
	return mp.tasks.audio.AudioClassifier.create_from_options(options)


def get_sneeze_index(result) -> int:
	for head in result.classifications:
		for category in head.categories:
			name = (category.category_name or category.display_name or "").lower()
			if name == "sneeze" and category.index is not None:
				return int(category.index)
	return YAMNET_SNEEZE_INDEX


def scores_from_result(result) -> np.ndarray:
	scores = np.zeros(YAMNET_CLASS_COUNT, dtype=np.float32)
	for head in result.classifications:
		for category in head.categories:
			if category.index is not None and 0 <= category.index < YAMNET_CLASS_COUNT:
				scores[category.index] = category.score
	return scores


def classify_audio(classifier, samples: np.ndarray, samplerate: int):
	waveform = np.asarray(samples, dtype=np.float32)
	if waveform.ndim > 1:
		waveform = waveform.mean(axis=1)
	waveform = np.nan_to_num(waveform, copy=False)
	waveform = np.clip(waveform, -1.0, 1.0)

	minimum_samples = int(samplerate * 0.98)
	if waveform.size < minimum_samples:
		waveform = np.pad(waveform, (0, minimum_samples - waveform.size))

	audio_data = mp.tasks.components.containers.AudioData.create_from_array(
		np.ascontiguousarray(waveform), sample_rate=samplerate
	)
	return classifier.classify(audio_data)[0]


def audio_windows(samples: np.ndarray, samplerate: int):
	window_size = max(1, int(samplerate * WINDOW_SECONDS))
	hop_size = max(1, int(samplerate * WINDOW_HOP_SECONDS))
	if samples.ndim > 1:
		samples = samples.mean(axis=1)

	if samples.size < window_size:
		yield samples
		return

	for start in range(0, samples.size - window_size + 1, hop_size):
		yield samples[start:start + window_size]


def similarity_threshold_for(fingerprints: np.ndarray) -> float:
	norms = np.linalg.norm(fingerprints, axis=1, keepdims=True)
	normalized = fingerprints / np.maximum(norms, 1e-8)
	if len(normalized) < 2:
		return 0.70

	similarities = normalized @ normalized.T
	np.fill_diagonal(similarities, -1.0)
	nearest = similarities.max(axis=1)
	return float(np.clip(np.percentile(nearest, 10) - 0.05, 0.55, 0.90))


def train_model(folder: Path) -> None:
	if not folder.is_dir():
		sys.exit(f"Error: '{folder}' is not a valid folder.")

	audio_files = sorted(
		path for path in folder.rglob("*")
		if path.is_file() and path.suffix.lower() in AUDIO_EXTENSIONS
	)
	if not audio_files:
		sys.exit(f"Error: No supported audio files found in '{folder}'.")

	model_path = ensure_yamnet_model()
	fingerprints = []
	sneeze_scores = []
	sneeze_index = YAMNET_SNEEZE_INDEX

	print(f"[INFO] Training from {len(audio_files)} audio file(s)...")
	with create_classifier(model_path) as classifier:
		for audio_file in audio_files:
			try:
				samples, samplerate = sf.read(audio_file, dtype="float32", always_2d=True)
				if not len(samples) or samplerate <= 0:
					print(f"[WARN] Skipping empty audio file: {audio_file}", file=sys.stderr)
					continue

				results = []
				for window in audio_windows(samples, int(samplerate)):
					results.append(classify_audio(classifier, window, int(samplerate)))
				vectors = [scores_from_result(result) for result in results]
				if not vectors:
					print(f"[WARN] No audio frames returned for: {audio_file}", file=sys.stderr)
					continue

				sneeze_index = get_sneeze_index(results[0])
				best = max(vectors, key=lambda vector: vector[sneeze_index])
				if np.linalg.norm(best) < 1e-8:
					print(f"[WARN] No usable sound classification for: {audio_file}", file=sys.stderr)
					continue

				fingerprints.append(best)
				sneeze_scores.append(float(best[sneeze_index]))
				print(f"[INFO] Learned {audio_file.name} (sneeze score {best[sneeze_index]:.3f})")
			except Exception as exc:
				print(f"[WARN] Could not read {audio_file}: {exc}", file=sys.stderr)

	if not fingerprints:
		sys.exit("Error: Could not learn from any audio files.")

	fingerprint_array = np.asarray(fingerprints, dtype=np.float32)
	sneeze_threshold = max(0.01, float(np.percentile(sneeze_scores, 10)) * 0.5)
	similarity_threshold = similarity_threshold_for(fingerprint_array)
	MEMORY_PATH.parent.mkdir(parents=True, exist_ok=True)
	np.savez_compressed(
		MEMORY_PATH,
		version=np.array(1, dtype=np.int16),
		fingerprints=fingerprint_array,
		sneeze_index=np.array(sneeze_index, dtype=np.int16),
		sneeze_threshold=np.array(sneeze_threshold, dtype=np.float32),
		similarity_threshold=np.array(similarity_threshold, dtype=np.float32),
	)

	print(f"[INFO] Trained from {len(fingerprints)} sneeze recording(s).")
	print(f"[INFO] Sneeze memory saved to {MEMORY_PATH}")


def load_memory() -> dict:
	if not MEMORY_PATH.is_file():
		sys.exit(
			"Error: No trained sneeze memory found. Run "
			"'bless-you --train <folder>' first."
		)

	try:
		with np.load(MEMORY_PATH, allow_pickle=False) as data:
			if int(data["version"]) != 1:
				raise ValueError("unsupported model memory version")
			fingerprints = np.asarray(data["fingerprints"], dtype=np.float32)
			memory = {
				"fingerprints": fingerprints,
				"sneeze_index": int(data["sneeze_index"]),
				"sneeze_threshold": float(data["sneeze_threshold"]),
				"similarity_threshold": float(data["similarity_threshold"]),
			}
	except Exception as exc:
		sys.exit(f"Error: Could not read trained sneeze memory: {exc}")

	if memory["fingerprints"].ndim != 2 or memory["fingerprints"].shape[1] != YAMNET_CLASS_COUNT:
		sys.exit("Error: Trained sneeze memory has an unexpected format. Train it again.")
	return memory


def match_sneeze(result, memory: dict) -> tuple[bool, float, float]:
	fingerprints = memory["fingerprints"]
	known_norms = np.linalg.norm(fingerprints, axis=1, keepdims=True)
	known = fingerprints / np.maximum(known_norms, 1e-8)
	vector = scores_from_result(result)
	if not np.linalg.norm(vector):
		return False, 0.0, 0.0

	sneeze_score = float(vector[memory["sneeze_index"]])
	vector = vector / max(float(np.linalg.norm(vector)), 1e-8)
	similarity = float(np.max(known @ vector))

	return (
		sneeze_score >= memory["sneeze_threshold"]
		and similarity >= memory["similarity_threshold"],
		sneeze_score,
		similarity,
	)


def detect_sneeze(classifier, memory: dict, device: str | int | None, samplerate: int):
	window_size = int(samplerate * WINDOW_SECONDS)
	hop_size = int(samplerate * WINDOW_HOP_SECONDS)
	audio_buffer = np.empty(0, dtype=np.float32)

	try:
		with sd.InputStream(
			device=device,
			samplerate=samplerate,
			channels=1,
			dtype="float32",
			blocksize=hop_size,
            latency="high",
		) as stream:
			print("[INFO] Listening for a sneeze...")
			while True:
				frame, overflowed = stream.read(hop_size)
				if overflowed:
					print("[WARN] Microphone audio overflowed; continuing.", file=sys.stderr)
				audio_buffer = np.concatenate((audio_buffer, frame[:, 0]))
				if audio_buffer.size < window_size:
					continue

				window = audio_buffer[-window_size:]
				audio_buffer = window[-(window_size - hop_size):]
				result = classify_audio(classifier, window, samplerate)
				matched, score, similarity = match_sneeze(result, memory)
				if matched:
					return score, similarity
	except KeyboardInterrupt:
		raise
	except Exception as exc:
		sys.exit(f"Error: Could not access the microphone or run the sound model. {exc}")


def command_exists(name: str) -> bool:
	return subprocess.run(
		["/bin/sh", "-lc", f"command -v {shlex.quote(name)} >/dev/null 2>&1"],
		check=False,
	).returncode == 0


def say_text(text: str) -> None:
	sysname = sys.platform
	if sysname == "darwin":
		command = ["say", text]
	elif sysname.startswith("linux"):
		if command_exists("spd-say"):
			command = ["spd-say", text]
		elif command_exists("espeak"):
			command = ["espeak", text]
		else:
			sys.exit("Error: No text-to-speech command found. Install 'spd-say' or 'espeak'.")
	elif sysname == "win32":
		safe_text = text.replace("'", "''")
		command = [
			"powershell",
			"-NoProfile",
			"-Command",
			(
				"Add-Type -AssemblyName System.Speech; "
				"$speak = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
				f"$speak.Speak('{safe_text}')"
			),
		]
	else:
		sys.exit("Error: Unsupported operating system for text-to-speech.")

	try:
		subprocess.run(command, check=True)
	except FileNotFoundError:
		sys.exit("Error: Text-to-speech command was not found on this system.")
	except subprocess.CalledProcessError as exc:
		sys.exit(f"Error: Text-to-speech failed with exit code {exc.returncode}.")


def main() -> None:
	parser = argparse.ArgumentParser(
		description="Listen for sneezes using an AI sound classifier and a profile built from example recordings.",
		formatter_class=argparse.RawTextHelpFormatter,
		add_help=False,
	)

	parser.add_argument("-h", "--help", action="help", help="Show help message and exit.")
	parser.add_argument(
		"-T",
		"--train",
		type=Path,
		metavar="FOLDER",
		help="Build or update the sneeze profile from audio files in FOLDER (for example, .local/training/bless-you).",
	).completer = DirectoriesCompleter()
	parser.add_argument(
		"-p",
		"--phrase",
		default="Bless you",
		help="Text to speak when a sneeze is detected (default: 'Bless you').",
	)
	parser.add_argument(
		"-d",
		"--device",
		type=parse_device,
		help="Input microphone device index or name (default: system default).",
	)
	parser.add_argument(
		"-r",
		"--samplerate",
		type=int,
		default=44_100,
		help="Microphone sample rate in Hz (default: 44100).",
	)
	parser.add_argument(
		"--cooldown",
		type=float,
		default=2.0,
		help="Seconds to wait before detecting another sneeze (default: 2.0).",
	)
	parser.add_argument(
		"--keep-listening",
		action="store_true",
		help="Keep listening after speaking instead of exiting after the first sneeze.",
	)

	argcomplete.autocomplete(parser, always_complete_options=False)
	args = parser.parse_args()

	if args.train:
		train_model(args.train.expanduser().resolve())
		return
	if args.samplerate < 8_000:
		parser.error("--samplerate must be at least 8000 Hz.")
	if args.cooldown < 0:
		parser.error("--cooldown cannot be negative.")

	memory = load_memory()
	model_path = ensure_yamnet_model()
	with create_classifier(model_path) as classifier:
		while True:
			score, similarity = detect_sneeze(
				classifier,
				memory,
				device=args.device,
				samplerate=args.samplerate,
			)
			if score > MIN_CONFIDENCE:
				print(
                    f"[INFO] Sneeze detected (AI score={score:.3f}, "
                    f"example match={similarity:.3f})."
                )
				say_text(args.phrase)
				if not args.keep_listening:
					return
			else:
				print(
					f"[INFO] Sneeze detected (AI score={score:.3f}, "
					f"example match={similarity:.3f}). "
					f"Discarding due to low confidence({MIN_CONFIDENCE})."
				)

			time.sleep(args.cooldown)


if __name__ == "__main__":
	main()

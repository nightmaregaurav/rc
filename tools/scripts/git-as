#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "argcomplete",
# ]
# ///

import sys
import argparse
import argcomplete
from pathlib import Path
from _git_profile import GIT_PROFILE_DIR, apply_profile, get_existing_profiles


# ──────────────────────────────── main ────────────────────────────────

def main():
    script_name = Path(sys.argv[0]).name.replace("-", " ", 1)
    existing_profiles = get_existing_profiles(GIT_PROFILE_DIR)

    parser = argparse.ArgumentParser(
        prog=script_name,
        description="Executes a git command with the specified profile.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )

    parser.add_argument(
        "-h", "--help",
        action="help",
        help="Show help message and exit",
    )

    parser.add_argument(
        "profile",
        help="Profile name to use (e.g., 'work', 'personal')",
        choices=existing_profiles
    )

    parser.add_argument(
        "git_args",
        nargs=argparse.REMAINDER,
        help="Git command and arguments to execute",
    )

    argcomplete.autocomplete(parser, always_complete_options=False)
    args = parser.parse_args()

    apply_profile(args.profile, args.git_args, validate=True)


if __name__ == "__main__":
    main()

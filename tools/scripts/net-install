#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "argcomplete",
#   "requests",
# ]
# ///

import argparse
import argcomplete
import os
import platform
import shutil
import subprocess
import sys
import tempfile
import tarfile
import zipfile
from pathlib import Path

import requests


ARCHIVE_EXTS = {".zip", ".tar", ".gz", ".bz2", ".xz", ".tar.gz", ".tar.bz2", ".tar.xz"}


def is_archive(path: Path) -> bool:
    """Check if a file looks like a known archive format."""
    name = path.name.lower()
    suffix = path.suffix.lower()

    # Check compound extensions like .tar.gz
    if name.endswith(".tar.gz") or name.endswith(".tar.bz2") or name.endswith(".tar.xz"):
        return True

    return suffix in ARCHIVE_EXTS


def get_filename_from_url(url: str, content_disposition: str | None = None) -> str:
    """Extract a filename from a URL or Content-Disposition header."""
    # Try Content-Disposition header first (e.g., "attachment; filename=...")
    if content_disposition:
        for part in content_disposition.split(";"):
            part = part.strip()
            if part.startswith("filename"):
                # Handle filename*=UTF-8''encoded_name as well
                name = part.split("=", 1)[-1].strip().strip('"')
                if name:
                    return name

    # Fall back to the last component of the URL path
    from urllib.parse import urlparse, unquote
    path = urlparse(url).path
    name = path.rsplit("/", 1)[-1] if path else "download"
    return unquote(name) or "download"


def download_file(url: str, dest_dir: Path) -> Path:
    """Download a file from a URL to the destination directory.

    Preserves the original filename from the URL (or Content-Disposition header)
    so that file extensions are available for archive detection.
    """
    print(f"Downloading: {url}")

    response = requests.get(url, stream=True, timeout=30)
    response.raise_for_status()

    filename = get_filename_from_url(
        url, response.headers.get("Content-Disposition")
    )
    dest = dest_dir / filename

    dest.write_bytes(response.content)
    print(f"Downloaded to: {dest}")
    return dest


def extract_archive(archive_path: Path, extract_dir: Path) -> Path:
    """Extract an archive to the target directory. Returns the extracted directory."""
    name = archive_path.name.lower()

    print(f"Extracting archive: {archive_path.name}")

    if name.endswith(".zip"):
        with zipfile.ZipFile(archive_path) as zf:
            zf.extractall(extract_dir)
    elif name.endswith((".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz", ".tar")):
        with tarfile.open(archive_path) as tf:
            tf.extractall(extract_dir)
    else:
        # Try tarfile for other known extensions
        try:
            with tarfile.open(archive_path) as tf:
                tf.extractall(extract_dir)
        except tarfile.TarError:
            print(f"Warning: Could not extract {archive_path.name}, treating as regular file.")
            archive_path.rename(extract_dir / archive_path.name)
            return archive_path.parent

    print(f"Extracted to: {extract_dir}")
    return extract_dir


def clean_contents(base_dir: Path, clean_files: list[str] | None, clean_folders: list[str] | None) -> None:
    """Remove files and folders matching the clean lists."""
    if clean_files:
        for filename in clean_files:
            target = base_dir / filename
            if target.is_file():
                target.unlink()
                print(f"Removed file: {filename}")

    if clean_folders:
        for foldername in clean_folders:
            target = base_dir / foldername
            if target.is_dir():
                shutil.rmtree(target)
                print(f"Removed folder: {foldername}")


def get_source_items(source_dir: Path) -> list[Path]:
    """Get the items to move from the source directory.

    If the source contains a single directory, return its contents.
    Otherwise return the items directly.
    """
    items = list(source_dir.iterdir())

    if len(items) == 1 and items[0].is_dir():
        # Single extracted folder — move its contents
        return list(items[0].iterdir())

    return items


def check_path_permission() -> None:
    """Check that the current user has permission to update machine-wide PATH.

    Runs before downloading so the user isn't left with a downloaded file
    if the PATH update would fail due to insufficient privileges.
    """
    os_type = detect_os()

    if os_type == "macos":
        paths_d = Path("/etc/paths.d")
        if not paths_d.exists():
            if not os.access("/etc", os.W):
                print("Error: Updating PATH requires root privileges on macOS.", file=sys.stderr)
                sys.exit(1)
        elif not os.access(paths_d, os.W):
            print("Error: Cannot write to /etc/paths.d. Run with sudo or check permissions.", file=sys.stderr)
            sys.exit(1)

    elif os_type == "linux":
        profile_d = Path("/etc/profile.d")
        if not profile_d.exists():
            if not os.access("/etc", os.W):
                print("Error: Updating machine-wide PATH requires root privileges on Linux.", file=sys.stderr)
                sys.exit(1)
        elif not os.access(profile_d, os.W):
            print("Error: Cannot write to /etc/profile.d. Run with sudo or check permissions.", file=sys.stderr)
            sys.exit(1)

    elif os_type == "windows":
        # In Git Bash/MSYS2, `net session` may not be available
        # Try multiple methods to detect admin privileges
        admin_detected = False

        # Method 1: Try `net session` (works in cmd/PowerShell)
        try:
            result = subprocess.run(
                ["net", "session"],
                capture_output=True,
                text=True,
            )
            if result.returncode == 0:
                admin_detected = True
        except (FileNotFoundError, OSError):
            pass

        # Method 2: Try `whoami /groups` (check for Administrators SID)
        if not admin_detected:
            try:
                result = subprocess.run(
                    ["whoami", "/groups"],
                    capture_output=True,
                    text=True,
                )
                if "S-1-5-32-544" in result.stdout:
                    admin_detected = True
            except (FileNotFoundError, OSError):
                pass

        # Method 3: Try via cmd.exe for Git Bash environments
        if not admin_detected:
            try:
                result = subprocess.run(
                    ["cmd.exe", "/c", "net", "session"],
                    capture_output=True,
                    text=True,
                )
                if result.returncode == 0:
                    admin_detected = True
            except (FileNotFoundError, OSError):
                pass

        if not admin_detected:
            print("Error: Updating machine-wide PATH requires administrator privileges on Windows.", file=sys.stderr)
            sys.exit(1)


def check_conflicts(source_items: list[Path], dest: Path, keep_mode: bool) -> list[str]:
    """Check for conflicts between source items and destination.

    Returns a list of conflicting filenames.
    In keep mode, conflicts mean source files that already exist in destination.
    """
    conflicts = []

    for item in source_items:
        target = dest / item.name
        if target.exists():
            conflicts.append(item.name)

    return conflicts


def move_items(source_items: list[Path], dest: Path, replace: bool, keep: bool) -> None:
    """Move items from source to destination with conflict resolution."""
    for item in source_items:
        target = dest / item.name

        if target.exists():
            if keep:
                print(f"Keeping existing: {item.name}")
                continue
            elif replace:
                if target.is_dir():
                    shutil.rmtree(target)
                print(f"Replacing: {item.name}")

        shutil.move(str(item), str(target))
        print(f"Moved: {item.name}")


def is_windows_env() -> bool:
    """Detect if running on Windows, including Git Bash/MSYS2/WSL environments."""
    # Direct Windows detection
    if platform.system().lower() == "windows":
        return True

    # Git Bash / MSYS2 / MinGW on Windows: platform.system() returns "Linux"
    # Check for MSYSTEM env var (set by MSYS2/Git Bash)
    if os.environ.get("MSYSTEM"):
        # Verify we're actually on Windows by checking for Windows-specific paths
        return os.path.exists(r"C:\Windows") or bool(os.environ.get("WINDIR"))

    # Check for other Windows indicators in POSIX-like environments
    if os.environ.get("PROGRAMFILES") or os.environ.get("PROGRAMFILES(X86)"):
        return True

    # Check if /proc/version contains Microsoft (WSL detection)
    try:
        with open("/proc/version", "r") as f:
            if "microsoft" in f.read().lower():
                return True
    except (FileNotFoundError, PermissionError):
        pass

    return False


def detect_os() -> str:
    """Detect the current operating system, including Git Bash/MSYS2 on Windows."""
    system = platform.system().lower()
    if system == "darwin":
        return "macos"

    # Check for Windows, including Git Bash/MSYS2/WSL environments
    if is_windows_env():
        return "windows"

    if system == "linux":
        return "linux"

    return "unknown"


def update_path_macos(dest: Path) -> None:
    """Update PATH on macOS using /etc/paths.d/."""
    paths_d = Path("/etc/paths.d")
    paths_d.mkdir(exist_ok=True)

    path_file = paths_d / dest.name
    if path_file.exists():
        print(f"PATH entry already exists: {path_file}")
        return

    path_file.write_text(str(dest) + "\n")
    print(f"Added PATH entry: {path_file}")
    print(f"Run 'source /etc/paths' or open a new terminal to apply.")


def update_path_linux(dest: Path) -> None:
    """Update machine-wide PATH on Linux using /etc/profile.d/. Requires root."""
    profile_d = Path("/etc/profile.d")
    profile_d.mkdir(exist_ok=True)

    script_name = f"{dest.name}.sh"
    script_path = profile_d / script_name

    if script_path.exists():
        print(f"PATH script already exists: {script_path}")
        return

    content = f"export PATH=\"$PATH:{dest}\"\n"
    script_path.write_text(content)
    script_path.chmod(0o644)
    print(f"Added PATH script: {script_path}")
    print("Run 'source /etc/profile' or open a new terminal to apply.")


def to_windows_path(path: Path) -> str:
    r"""Convert a path to Windows format.

    Handles Git Bash/MSYS2 paths like /c/Users/... -> C:\Users\...
    and forward slashes to backslashes.
    """
    path_str = str(path)

    # Convert MSYS2/Git Bash style paths (/c/... -> C:\...)
    if path_str.startswith("/") and len(path_str) >= 3 and path_str[2] == "/":
        drive = path_str[1:2].upper()
        rest = path_str[3:].replace("/", "\\")
        return f"{drive}:\\{rest}"

    # Convert forward slashes to backslashes
    return path_str.replace("/", "\\")


def update_path_windows(dest: Path) -> None:
    """Update machine-wide PATH on Windows via the system registry.

    Reads the current system PATH from the registry, appends the new entry
    if not already present, and writes it back — avoiding the %PATH%
    expansion pitfall that can duplicate user/system entries.

    Falls back to reg.exe if winreg is unavailable (e.g., in Git Bash/MSYS2).
    """
    key_path = r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
    value_name = "PATH"
    dest_str = to_windows_path(dest)

    # Try winreg first (native Windows Python)
    try:
        _update_path_windows_winreg(key_path, value_name, dest_str)
        return
    except ImportError:
        # winreg not available (e.g., MSYS2 Python), fall through to reg.exe
        pass
    except Exception as e:
        print(f"Warning: winreg method failed: {e}", file=sys.stderr)
        print("Attempting fallback method (reg.exe)...", file=sys.stderr)

    # Fallback: use reg.exe (works from Git Bash/MSYS2)
    try:
        _update_path_windows_reg_exe(key_path, value_name, dest_str)
        return
    except Exception as e:
        print(f"Error: All methods to update Windows PATH failed: {e}", file=sys.stderr)
        sys.exit(1)


def _update_path_windows_winreg(key_path: str, value_name: str, dest_str: str) -> None:
    """Update PATH using winreg module (native Windows Python)."""
    import winreg

    with winreg.OpenKey(
        winreg.HKEY_LOCAL_MACHINE, key_path, 0, winreg.KEY_WRITE
    ) as key:
        current, _ = winreg.QueryValueEx(key, value_name)

    if dest_str in current.split(os.pathsep):
        print(f"PATH entry already exists in system registry: {dest_str}")
        return

    with winreg.OpenKey(
        winreg.HKEY_LOCAL_MACHINE, key_path, 0, winreg.KEY_WRITE
    ) as key:
        winreg.SetValueEx(key, value_name, 0, winreg.REG_EXPAND_SZ, current + os.pathsep + dest_str)

    print("Machine-wide PATH updated via system registry (HKEY_LOCAL_MACHINE).")
    print("Open a new Command Prompt or PowerShell window to apply.")


def _update_path_windows_reg_exe(key_path: str, value_name: str, dest_str: str) -> None:
    """Update PATH using reg.exe (works from Git Bash/MSYS2 environments)."""
    # Query current PATH
    query_cmd = [
        "reg.exe", "query",
        f"HKEY_LOCAL_MACHINE\\{key_path}",
        "/v", value_name
    ]
    result = subprocess.run(query_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise OSError(f"reg.exe query failed: {result.stderr.strip()}")

    # Parse the output - reg.exe returns the value on the last non-empty line
    lines = result.stdout.strip().split("\n")
    current = ""
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("HKEY") and "ERROR" not in stripped:
            # Format: "REG_EXPAND_SZ    <value>" or "<type>    <value>"
            parts = stripped.split("\t", 1)
            if len(parts) == 2:
                current = parts[1].strip()
            else:
                # Try splitting by multiple spaces
                parts = stripped.split(None, 1)
                if len(parts) == 2:
                    current = parts[1].strip()

    if dest_str in current.split(";"):
        print(f"PATH entry already exists in system registry: {dest_str}")
        return

    new_path = current + ";" + dest_str if current else dest_str

    # Set the new PATH
    set_cmd = [
        "reg.exe", "add",
        f"HKEY_LOCAL_MACHINE\\{key_path}",
        "/v", value_name,
        "/t", "REG_EXPAND_SZ",
        "/d", new_path,
        "/f"
    ]
    result = subprocess.run(set_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise OSError(f"reg.exe add failed: {result.stderr.strip()}")

    print("Machine-wide PATH updated via system registry (reg.exe).")
    print("Open a new Command Prompt or PowerShell window to apply.")


def update_path(dest: Path) -> None:
    """Update machine-wide PATH to include the destination directory."""
    os_type = detect_os()
    print(f"Detected OS: {os_type}")

    if os_type == "macos":
        update_path_macos(dest)
    elif os_type == "linux":
        update_path_linux(dest)
    elif os_type == "windows":
        update_path_windows(dest)
    else:
        print(f"Warning: Cannot update PATH for unknown OS: {os_type}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(
        description="Download content from a URL, optionally clean it, and install to a local path.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )

    parser.add_argument("url", help="URL to download from (usually a zip archive).")
    parser.add_argument("path", help="Destination path in the local filesystem.")

    parser.add_argument(
        "-c", "--clean",
        nargs="*",
        default=[],
        help="File names to remove before installing.",
    )
    parser.add_argument(
        "-C", "--clean-folder",
        nargs="*",
        default=[],
        help="Folder names to remove before installing.",
    )
    parser.add_argument(
        "-r", "--replace",
        action="store_true",
        help="Replace existing files in the destination with the same name.",
    )
    parser.add_argument(
        "-w", "--wipe",
        action="store_true",
        help="Wipe the destination directory clean before installing (if it exists).",
    )
    parser.add_argument(
        "-k", "--keep",
        action="store_true",
        help="Keep existing files in the destination; skip overwriting. "
             "If all files conflict, abort with an error.",
    )
    parser.add_argument(
        "-p", "--update-path",
        action="store_true",
        help="Update machine-wide PATH to include the destination directory.",
    )

    parser.add_argument("-h", "--help", action="help", help="Show help message and exit.")

    argcomplete.autocomplete(parser, always_complete_options=False)
    args = parser.parse_args()

    dest = Path(args.path).expanduser().resolve()

    # Check PATH update permission before downloading
    if args.update_path:
        check_path_permission()

    # Create a temporary working directory
    with tempfile.TemporaryDirectory() as tmp:
        tmp_dir = Path(tmp)

        # 1. Download (preserves original filename from URL for archive detection)
        downloaded = download_file(args.url, tmp_dir)

        # 2. Extract if archive
        if is_archive(downloaded):
            extract_dir = tmp_dir / "extracted"
            extract_dir.mkdir()
            work_dir = extract_archive(downloaded, extract_dir)
        else:
            work_dir = tmp_dir
            # Move downloaded file to work_dir root for uniform handling
            downloaded.rename(work_dir / downloaded.name)

        # 3. Clean unwanted files/folders
        clean_contents(work_dir, args.clean or None, args.clean_folder or None)

        # 4. Prepare destination
        if dest.exists():
            if args.wipe:
                if dest.is_dir():
                    shutil.rmtree(dest)
                    print(f"Wiped destination: {dest}")
                else:
                    dest.unlink()
                    print(f"Removed existing file: {dest}")
        dest.mkdir(parents=True, exist_ok=True)

        # 5. Get source items and check conflicts
        source_items = get_source_items(work_dir)

        if not source_items:
            print("Error: Nothing to install after cleaning.", file=sys.stderr)
            sys.exit(1)

        if args.keep:
            conflicts = check_conflicts(source_items, dest, keep_mode=True)
            if len(conflicts) == len(source_items):
                print("Error: All files already exist in destination. Nothing to install.", file=sys.stderr)
                sys.exit(1)

        # 6. Move items to destination
        move_items(source_items, dest, args.replace, args.keep)

    print(f"Installation complete: {dest}")

    # 7. Update machine-wide PATH if requested
    if args.update_path:
        update_path(dest)


if __name__ == "__main__":
    main()

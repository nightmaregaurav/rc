#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "argcomplete",
# ]
# ///

import sys
import argparse
import argcomplete
from pathlib import Path


def extract_script_list():
    scripts_dir = Path(__file__).parent

    if not scripts_dir.is_dir():
        print(f"Error: {scripts_dir} not found.", file=sys.stderr)
        sys.exit(1)

    # Collect executable scripts, excluding this script itself
    scripts = []
    for entry in scripts_dir.iterdir():
        if entry.is_file() and entry.is_symlink() == False:
            # Skip hidden files, __pycache__, and this script
            if entry.name.startswith(".") or entry.name == "rc-ls":
                continue
            # Check if it's executable (has no extension and is a script)
            if entry.suffix == "":
                scripts.append(entry.name)

    scripts.sort()
    for idx, name in enumerate(scripts, 1):
        numbering = f"{idx:03d}."
        print(f"{numbering} {name}")

    print(f"\nTotal tools: {len(scripts)}")


def main():
    parser = argparse.ArgumentParser(
        description="Lists tools provided by RC and their short descriptions.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )

    parser.add_argument(
        "-h",
        "--help",
        action="help",
        help="Show help message and exit.",
    )

    argcomplete.autocomplete(parser, always_complete_options=False)
    parser.parse_args()

    extract_script_list()


if __name__ == "__main__":
    main()
